---
import '../styles/site.css'
import biz from '../../content/business.json'
import { hourRows, telHref } from '@nhd/shared/content'

const { title, description } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const tel = telHref(biz.phone.value)
const rows = hourRows(biz.hours.value)
const nav = [
  { href: `${base}/#gentle`, label: 'Gentle care' },
  { href: `${base}/services`, label: 'Services' },
  { href: `${base}/#reserve`, label: 'Reserve' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${base}/assets/og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#eff2ec" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
  </head>
  <body>
    <a href="#main" style="position:absolute;left:-9999px;background:#2f3a32;color:#fbfcfa;padding:12px 18px;z-index:99" onfocus="this.style.left='0'" onblur="this.style.left='-9999px'">Skip to content</a>

    <header class="nav">
      <div class="nav-in" style="position:relative">
        <a class="brand" href={`${base}/`}>Cali New <span>Nails</span></a>
        <nav class="nlinks" aria-label="Primary">{nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
        <div style="display:flex;gap:10px;align-items:center">
          <a class="btn btn-sm" href={`${base}/#reserve`}>Reserve</a>
          <button class="menu-btn" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer"><i></i></button>
        </div>
      </div>
    </header>

    <div class="drawer" id="drawer" hidden role="dialog" aria-modal="true" aria-label="Menu">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <span class="eyebrow">Menu</span>
        <button class="x" id="drawer-close" type="button" aria-label="Close menu">✕</button>
      </div>
      <nav aria-label="Mobile">{nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
      <a class="btn" href={tel} style="justify-content:center">{biz.phone.value}</a>
    </div>

    <main id="main"><slot /></main>

    <footer class="foot">
      <div class="wrap">
        <div class="foot-grid">
          <div>
            <p class="eyebrow">{biz.display_name}</p>
            <p class="h2" style="margin-top:12px;max-width:14ch">Two chairs, and all the time you need in one.</p>
            <p class="small" style="margin-top:14px">{biz.address.value}</p>
            <p style="display:grid;gap:8px;margin-top:16px;font-size:16px">
              <a href={tel} style="justify-self:start">{biz.phone.value}</a>
              <a href={biz.map_url} target="_blank" rel="noopener" style="justify-self:start">Directions on Google Maps</a>
            </p>
          </div>
          <div>
            <p class="eyebrow">Hours</p>
            <dl class="hrs" style="margin-top:12px">
              {rows.map((r) => (<div class={r.closed ? 'off' : ''}><dt>{r.label}</dt><dd style="margin:0">{r.value}</dd></div>))}
            </dl>
          </div>
          <div>
            <p class="eyebrow">On Google</p>
            <p style="font-size:56px;font-weight:300;margin:8px 0 0;line-height:1;letter-spacing:-.04em">{biz.rating.value}</p>
            <p class="small" style="margin:0">from {biz.rating.count} reviews</p>
            <p class="small" style="margin-top:14px;max-width:26ch">Some of those reviewers have been coming for more than ten years.</p>
          </div>
        </div>
        <div class="fine">
          <p style="margin:0">Speculative redesign concept for {biz.display_name}. Not the salon's official website, not published and not indexed. Reservations here are a demonstration and transmit nothing.</p>
          <p style="margin:0">Photography is licensed stock.</p>
        </div>
      </div>
    </footer>

    <script>
      import { dialog } from '@nhd/shared/ui'
      const drawer = document.getElementById('drawer')
      const burger = document.getElementById('burger')
      const d = dialog(drawer, { onClose: () => burger.setAttribute('aria-expanded', 'false') })
      burger.addEventListener('click', () => { d.open(); burger.setAttribute('aria-expanded', 'true') })
      document.getElementById('drawer-close').addEventListener('click', d.close)
      drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', d.close))
    </script>
  </body>
</html>
