---
import '../styles/site.css'
import T from '../components/T.astro'
import biz from '../../content/business.json'
import { hourRows, telHref } from '@nhd/shared/content'

const { title, description } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const tel = telHref(biz.phone.value)
const rowsEn = hourRows(biz.hours.value, 'en')
const rowsEs = hourRows(biz.hours.value, 'es')
const nav = [
  { href: `${base}/lookbook`, en: 'Lookbook', es: 'Lookbook' },
  { href: `${base}/#services`, en: 'Services', es: 'Servicios' },
  { href: `${base}/#visit`, en: 'Visit', es: 'Visítanos' },
  { href: `${base}/#reserve`, en: 'Reserve', es: 'Reservar' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${base}/assets/og.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f3ede9" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={`${base}/fonts/fonts.css`} />
  </head>
  <body>
    <a href="#main" style="position:absolute;left:-9999px;background:#43303a;color:#fff;padding:12px 18px;z-index:99" onfocus="this.style.left='0'" onblur="this.style.left='-9999px'">Skip to content</a>

    <header class="nav">
      <div class="nav-in">
        <a class="word" href={`${base}/`}>Marytere</a>
        <nav class="nlinks" aria-label="Primary">{nav.map((n) => (<a href={n.href}><T en={n.en} es={n.es} /></a>))}</nav>
        <div class="nav-r">
          <div class="lang" role="group" aria-label="Language / Idioma">
            <button type="button" data-lang-btn="en" aria-pressed="true">EN</button><button type="button" data-lang-btn="es" aria-pressed="false">ES</button>
          </div>
          <a class="btn btn-sm" href={`${base}/#reserve`}><T en="Reserve" es="Reservar" /></a>
          <button class="menu-btn" id="burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="drawer"><i></i></button>
        </div>
      </div>
    </header>

    <div class="drawer" id="drawer" hidden role="dialog" aria-modal="true" aria-label="Menu">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <span class="eyebrow">Menu</span>
        <button class="x" id="drawer-close" type="button" aria-label="Close menu">✕</button>
      </div>
      <nav aria-label="Mobile">{nav.map((n) => (<a href={n.href}><T en={n.en} es={n.es} /></a>))}</nav>
      <a class="btn" href={tel} style="justify-content:center">{biz.phone.value}</a>
    </div>

    <main id="main"><slot /></main>

    <footer class="foot">
      <div class="col-wide">
        <div class="foot-grid">
          <div>
            <p class="eyebrow">Marytere</p>
            <p class="h2" style="margin-top:10px;font-size:clamp(24px,3vw,34px);max-width:12ch">
              <T en="Salon & barbershop, one room." es="Salón y barbería, un solo lugar." />
            </p>
            <p class="small" style="margin-top:12px">{biz.address.value}</p>
            <p style="display:grid;gap:7px;margin-top:14px;font-size:15px">
              <a href={tel} style="justify-self:start">{biz.phone.value}</a>
              <a href={biz.map_url} target="_blank" rel="noopener" style="justify-self:start"><T en="Directions" es="Cómo llegar" /></a>
              <a href={biz.socials.instagram.value} target="_blank" rel="noopener" style="justify-self:start">Instagram</a>
              <a href={biz.socials.facebook.value} target="_blank" rel="noopener" style="justify-self:start">Facebook</a>
            </p>
          </div>
          <div>
            <p class="eyebrow"><T en="Hours" es="Horario" /></p>
            <dl class="hrs" style="margin-top:12px" data-l="en">
              {rowsEn.map((r) => (<div class={r.closed ? 'off' : ''}><dt>{r.label}</dt><dd style="margin:0">{r.value}</dd></div>))}
            </dl>
            <dl class="hrs" style="margin-top:12px" data-l="es" hidden>
              {rowsEs.map((r) => (<div class={r.closed ? 'off' : ''}><dt>{r.label}</dt><dd style="margin:0">{r.value}</dd></div>))}
            </dl>
          </div>
          <div>
            <p class="eyebrow">Google</p>
            <p style="font-family:var(--font-display);font-size:56px;margin:6px 0 0;line-height:1">{biz.rating.value}</p>
            <p class="small" style="margin:0"><T en={`from ${biz.rating.count} reviews`} es={`de ${biz.rating.count} reseñas`} /></p>
          </div>
        </div>
        <div class="fine">
          <p style="margin:0">
            <T
              en={`Speculative redesign concept for ${biz.display_name}. Not the salon's official website, not published and not indexed. Reservations here are a demonstration and transmit nothing.`}
              es={`Concepto de rediseño especulativo para ${biz.display_name}. No es el sitio oficial, no está publicado ni indexado. Las reservas son una demostración y no envían nada.`}
            />
          </p>
          <p style="margin:0"><T en="Photography is licensed stock." es="Fotografía de archivo con licencia." /></p>
        </div>
      </div>
    </footer>

    <script>
      import { dialog, language } from '@nhd/shared/ui'
      const drawer = document.getElementById('drawer')
      const burger = document.getElementById('burger')
      const d = dialog(drawer, { onClose: () => burger.setAttribute('aria-expanded', 'false') })
      burger.addEventListener('click', () => { d.open(); burger.setAttribute('aria-expanded', 'true') })
      document.getElementById('drawer-close').addEventListener('click', d.close)
      drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', d.close))
      language('en')
    </script>
  </body>
</html>
