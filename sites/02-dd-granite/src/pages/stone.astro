---
import Base from '../layouts/Base.astro'
import biz from '../../content/business.json'
import { img } from '@nhd/shared/content'
import { SLABS } from '../data/slabs.mjs'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const groups = ['Granite', 'Quartz', 'Solid surface']
const intro = {
  Granite: 'Quarried stone, cut from the earth. No two slabs are identical, so the piece you stand in front of is the piece you get. Seal it once a year and it will outlast the kitchen around it.',
  Quartz: 'Engineered from crushed quartz and resin. Colour and pattern repeat predictably, which is why it suits long runs and island-plus-perimeter jobs. Non-porous, so no sealing at all.',
  'Solid surface': 'Cast rather than quarried. Its real advantage is that seams can be fused and sanded until they disappear, which matters on very long counters and integrated sinks.',
}
---

<Base
  title="Surfaces — D&amp;D Granite"
  description="Granite, quartz and solid surface countertops explained, with the surface types D&amp;D Granite works in."
>
  <section class="sect" style="padding-top:clamp(30px,4vw,54px)">
    <div class="wrap">
      <p class="eyebrow">Surfaces</p>
      <h1 class="h1" style="margin-top:10px;max-width:15ch">Three materials. Very different lives.</h1>
      <p class="lead" style="margin-top:16px">
        Most people arrive knowing they want "granite" and leave with something else, because the way a surface behaves
        day to day matters more than the category on the price list.
      </p>
      <a class="btn" href={`${base}/#wall`} style="margin-top:22px">Back to the stone wall</a>
    </div>
  </section>

  {groups.map((g) => (
    <section class="sect" style="padding-top:0">
      <div class="wrap">
        <div class="sect-head">
          <p class="eyebrow">{g}</p>
          <h2 class="h2" style="max-width:20ch">{g === 'Granite' ? 'Every slab is one of one.' : g === 'Quartz' ? 'Matches end to end, every time.' : 'Seams you cannot find.'}</h2>
          <p class="lead">{intro[g]}</p>
        </div>
        <div class="wall">
          {SLABS.filter((s) => s.cat === g).map((s) => {
            const im = img(base, s.n)
            return (
              <figure class="slab" style="margin:0;cursor:default">
                <picture>
                  <source type="image/webp" srcset={im.webp} sizes="(min-width:1000px) 20vw, (min-width:640px) 33vw, 50vw" />
                  <img src={im.fallback} alt={`${s.cat} surface — ${s.name}`} loading="lazy" width="1200" height="1200" />
                </picture>
                <figcaption><b>{s.name}</b><small>{s.note}</small></figcaption>
              </figure>
            )
          })}
        </div>
      </div>
    </section>
  ))}

  <section class="sect" style="padding-top:0">
    <div class="wrap">
      <div class="rev" style="display:grid;gap:16px">
        <h2 class="h2" style="max-width:16ch">Still deciding? Bring the cabinet door with you.</h2>
        <p class="lead" style="max-width:52ch">
          The single most useful thing you can carry into a showroom is a cabinet door and a piece of your flooring.
          Everything else is guesswork under different lighting.
        </p>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
          <a class="btn" href={biz.map_url} target="_blank" rel="noopener">Directions</a>
          <a class="btn btn-o" href={`${base}/#quote`}>Request a quote</a>
        </div>
      </div>
      <p class="small" style="margin-top:18px">
        Surface photography is licensed stock illustrating material types. It is not a photograph of stock currently on
        {' '}{biz.display_name}'s floor.
      </p>
    </div>
  </section>
</Base>
